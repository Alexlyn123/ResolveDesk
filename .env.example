APP_NAME=ResolveDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The URL people open in the browser. Must match the host they actually use.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8+ or MariaDB 10.4+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resolvedesk
DB_USERNAME=root
DB_PASSWORD=

# --- Session and Sanctum (cookie-based SPA authentication) -------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set SESSION_SECURE_COOKIE=true (HTTPS only) and SESSION_ENCRYPT=true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Hosts (with port) the React app is served from. Requests from these hosts
# are authenticated with the session cookie and protected by CSRF.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000,localhost:5173,127.0.0.1:5173

# Origin(s) allowed to call the API with credentials, comma separated.
# Only matters when the frontend is hosted on a different origin than the API.
FRONTEND_URL=http://localhost:8000

# --- ResolveDesk --------------------------------------------------------------
RESOLVEDESK_TICKET_PREFIX=RD
# Slug of the workspace that people who register without a workspace code join
# as customers. The demo seeder creates "northgate-residences". Leave empty to
# require a workspace code or a new workspace after registration.
RESOLVEDESK_DEFAULT_ORGANIZATION=northgate-residences

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend (read by Vite at build time) ------------------------------------
VITE_APP_NAME="${APP_NAME}"
# Base URL of the Laravel API. Leave empty when Laravel serves the React app
# (same origin). Set it, e.g. https://api.example.com, for a separate frontend host.
VITE_API_BASE_URL=
# Show a "Demo accounts" helper on the sign-in page. Local demonstrations only;
# never enable in production.
VITE_SHOW_DEMO_ACCOUNTS=false
